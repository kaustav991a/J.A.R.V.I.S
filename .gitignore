# Backend
jarvis-backend/venv/
jarvis-backend/__pycache__/
jarvis-backend/logs/
jarvis-backend/jarvis_chroma_db/
jarvis-backend/credentials/
*.pyc

# --- Large model binaries (re-downloadable — see README "Fresh Install") ---
jarvis-backend/models/vosk/
jarvis-backend/*.onnx
jarvis-backend/*.onnx.json
jarvis-backend/*.pt
jarvis-backend/*.tar.gz

# --- Personal memory / RAG stores (auto-created; never commit) ---
jarvis-backend/*.db
# In-flight migration copies and sqlite sidecars. `*.db` above does NOT cover
# these: `jarvis_longterm.db.sourcing-<stamp>` does not END in `.db`. A verify
# that fails leaves one on disk on purpose, and it holds the same rows the live
# store does — it must not be one `git add -A` away from being published.
jarvis-backend/*.db.*
jarvis-backend/*.db-wal
jarvis-backend/*.db-shm
jarvis-backend/memory/vector_db/
jarvis-backend/personal_chroma_db/
jarvis-backend/action_chroma_db/

# --- Memory encryption keys (C#11a) — losing these loses the memory ---
jarvis-backend/jarvis_key.*
jarvis-backend/jarvis_x25519.enc

# --- Sealed-fact queue runtime state (C#11a Step 4) — never commit any of it.
# fact_quarantine/  records that failed to open, kept for inspection
# fact_outbox.jsonl the cloud-side spill: sealed envelopes awaiting the desk
# fact_desk_key.json the cached desk PUBLIC half (not secret, but not ours to
#                    publish either — it names the key his facts are sealed to)
# The ledger is a *.db and already covered above. ---
jarvis-backend/fact_quarantine/
jarvis-backend/fact_outbox.jsonl
jarvis-backend/fact_desk_key.json

# --- Test/tooling caches ---
jarvis-backend/.pytest_cache/

# --- Runtime artifacts ---
jarvis-backend/watchdog.log
jarvis-backend/error.log
jarvis-backend/last_boot_date.txt
jarvis-backend/test_grid_output.jpg

# Frontend
jarvis-frontend/node_modules/
jarvis-frontend/dist/

# OS Files
.DS_Store
.env
KEys.txt
